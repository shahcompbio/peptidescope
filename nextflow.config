/*
 * Author: Asher Preska Steinberg
 *
 */

manifest {
    name = 'shahcompbio/peptidescope'
    version = '0.0.1'
    description = 'visualize MS-detected peptides with transcript structures'
    author = 'Asher Preska Steinberg'
    nextflowVersion = '>=24.10.5'
}

enable.dsl = 2
enable.plugins = true
plugins {
    id 'nf-schema@2.4.1'
}

/*
 * default params
 */
params.protein_info = null
params.transcript_gtf = null
params.transdecoder_gff3 = null
params.transcripts_fasta = null
params.outdir = null
params.fragpipe_dir = null
params.sample_id = null
params.igv_report = false
params.bigwig = null
params.protein_list = null
params.ref_genome = null
params.ref_genome_index = null

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    slurm {
        executor {
            name              = 'slurm'
            pollInterval      = '2 min'
            queueStatInterval = '5 min'
            submitRateLimit   = '20/1min'
            queueSize         = 50
            exitReadTimeout   = '10 min'
            dumpInterval      = '5 min'
            queueGlobalStatus = true
        }
        process {
            queue         = { task.time && task.time <= 2.hour ? 'cpushort' : 'componc_cpu' }
            errorStrategy = {
                if (task.exitStatus in [143, 137, 104, 134, 139, 140, Integer.MAX_VALUE]) {
                    sleep(Math.pow(2, task.attempt) * 2000 as Integer)
                    return 'retry'
                }
                else {
                    return 'finish'
                }
            }
            maxRetries    = 2
            array         = 100
            cache         = 'lenient'
        }
    }
}


process {

    resourceLimits = [cpus: 10, memory: 100.GB, time: 4.h]

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 1
    maxErrors = '-1'
    withName: "IGVREPORT" {
        cpus = 2
        memory = { 30.GB * task.attempt }
        time = { 1.h * task.attempt }
    }
    withLabel: process_low {
        cpus = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 1.h * task.attempt }
    }
    withLabel: process_single {
        cpus = 1
        memory = { 6.GB * task.attempt }
        time = { 1.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries = 2
    }
}

// nf-schema params

validation {
    help {
        enabled = true
    }
}
